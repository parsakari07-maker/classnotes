# ====================================================================
# ClassNotes Infrastructure Environment Configuration
# Stack: GitHub + Cloudflare Workers + Cloudflare R2 + Neon PostgreSQL
# ====================================================================

# 1. Neon PostgreSQL Database Connection
# Obtain this from your Neon Console (https://console.neon.tech)
DATABASE_URL="postgres://username:password@ep-sample-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Cloudflare R2 Storage Credentials (for Workers and S3-compatible clients)
# Obtain these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID="your_cloudflare_account_id_here"
R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
R2_BUCKET_NAME="classnotes-storage"

# 3. Direct R2 Public URL (for High-Performance Direct Asset Delivery - Non-Proxy)
# Configure a custom domain or enable r2.dev public URL in your R2 bucket settings
R2_PUBLIC_URL="https://pub-classnotes.r2.dev"

# 4. Authentication Secret
AUTH_SECRET="your_long_random_jwt_secret_token_here_1405"

# 5. App URL
APP_URL="https://classnotes.yourdomain.workers.dev"
